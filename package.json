{
  "name": "ligadeals-berlin",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rm -rf .next out node_modules/.cache",
    "sanity": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "seed": "tsx scripts/seedContent.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lighthouse": "node scripts/lighthouse.js",
    "lighthouse:build": "npm run build && npm run start & sleep 5 && npm run lighthouse",
    "a11y": "node scripts/a11y-test.js",
    "a11y:ci": "CI=true node scripts/a11y-test.js",
    "verify:deployment": "tsx scripts/verifyDeployment.ts",
    "predeploy": "npm run verify:deployment && npm run build",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sanity/client": "^7.24.0",
    "@sanity/image-url": "^1.2.0",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.23.22",
    "next": "^16.2.10",
    "next-sanity": "^13.1.3",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.63.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.1.2",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@sanity/ui": "^3.3.5",
    "@sanity/vision": "^5.31.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.23",
    "sanity": "^5.31.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "comments": {
    "overrides": "Transitive deps pinned past advisories their parents have not picked up yet. postcss and sharp: next bundles older copies (sourceMappingURL path traversal; libvips CVEs) and $ref keeps them on the version this package.json already declares. adm-zip: reached through sanity's CLI (4GB alloc on crafted zip). js-yaml is scoped to @vercel/frameworks because only its 3.x copy is affected and a global pin would drag 4.x consumers backwards. Drop an entry once the parent ships a fixed range."
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "adm-zip": "^0.6.0",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.0"
    }
  }
}
